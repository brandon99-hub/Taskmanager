<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Due Soon Reminder - TaskFlow</title>
    <style>
        /* Reset styles */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; }
        
        /* Container */
        .email-container { 
            max-width: 600px; 
            margin: 0 auto; 
            background: #ffffff; 
            border-radius: 12px; 
            overflow: hidden; 
            box-shadow: 0 10px 25px rgba(0,0,0,0.1); 
        }
        
        /* Header */
        .header { 
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); 
            padding: 30px 20px; 
            text-align: center; 
            color: white; 
        }
        .logo { height: 40px; margin-bottom: 15px; }
        .header h1 { 
            font-size: 28px; 
            font-weight: 600; 
            margin: 0; 
            text-shadow: 0 2px 4px rgba(0,0,0,0.2); 
        }
        .header p { 
            font-size: 16px; 
            opacity: 0.9; 
            margin-top: 8px; 
        }
        
        /* Urgent Banner */
        .urgent-banner {
            background: linear-gradient(90deg, #fbbf24 0%, #f59e0b 100%);
            color: #92400e;
            padding: 15px 20px;
            text-align: center;
            font-weight: 600;
            font-size: 16px;
            border-bottom: 3px solid #d97706;
        }
        .urgent-icon {
            display: inline-block;
            margin-right: 8px;
            animation: bounce 2s infinite;
        }
        
        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
            40% { transform: translateY(-10px); }
            60% { transform: translateY(-5px); }
        }
        
        /* Content */
        .content { padding: 30px 20px; }
        .greeting { 
            font-size: 20px; 
            color: #333; 
            margin-bottom: 20px; 
            font-weight: 500; 
        }
        .intro { 
            font-size: 16px; 
            color: #666; 
            margin-bottom: 30px; 
            line-height: 1.6; 
        }
        
        /* Task Card */
        .task-card { 
            background: #fffbeb; 
            border-radius: 12px; 
            padding: 25px; 
            margin: 25px 0; 
            border-left: 5px solid #f59e0b; 
            box-shadow: 0 2px 10px rgba(245, 158, 11, 0.1); 
            border: 1px solid #fcd34d; 
        }
        
        .task-header { 
            display: flex; 
            justify-content: space-between; 
            align-items: flex-start; 
            margin-bottom: 15px; 
            flex-wrap: wrap; 
        }
        .task-title { 
            font-size: 22px; 
            font-weight: 600; 
            color: #92400e; 
            margin: 0; 
            flex: 1; 
            min-width: 200px; 
        }
        
        /* Due Date Countdown */
        .due-countdown {
            background: #fef3c7;
            border: 2px solid #fbbf24;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            margin: 20px 0;
        }
        .countdown-label {
            font-size: 14px;
            color: #92400e;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .countdown-value {
            font-size: 32px;
            font-weight: 700;
            color: #d97706;
            line-height: 1;
        }
        .countdown-unit {
            font-size: 16px;
            color: #92400e;
            font-weight: 500;
        }
        
        /* Priority Badge */
        .priority-badge { 
            display: inline-block; 
            padding: 6px 12px; 
            border-radius: 20px; 
            font-size: 12px; 
            font-weight: 600; 
            text-transform: uppercase; 
            letter-spacing: 0.5px; 
            margin-left: 10px; 
            background: #fecaca; 
            color: #991b1b; 
        }
        
        .task-description { 
            font-size: 16px; 
            color: #92400e; 
            margin: 15px 0; 
            line-height: 1.6; 
        }
        
        /* Task Details Grid */
        .task-details { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); 
            gap: 20px; 
            margin: 20px 0; 
        }
        .detail-item { 
            background: white; 
            padding: 15px; 
            border-radius: 8px; 
            border: 1px solid #fbbf24; 
        }
        .detail-label { 
            font-size: 14px; 
            font-weight: 600; 
            color: #92400e; 
            margin-bottom: 5px; 
            display: flex; 
            align-items: center; 
        }
        .detail-label .icon { margin-right: 6px; }
        .detail-value { 
            font-size: 16px; 
            font-weight: 500; 
            color: #1f2937; 
        }
        
        /* Progress Bar */
        .progress-container { 
            margin: 20px 0; 
        }
        .progress-label { 
            font-size: 14px; 
            font-weight: 600; 
            color: #92400e; 
            margin-bottom: 8px; 
        }
        .progress-bar { 
            background: #fef3c7; 
            border-radius: 10px; 
            height: 12px; 
            overflow: hidden; 
            border: 1px solid #fbbf24; 
        }
        .progress-fill { 
            background: linear-gradient(90deg, #f59e0b 0%, #d97706 100%); 
            height: 100%; 
            border-radius: 10px; 
            transition: width 0.3s ease; 
        }
        
        /* Action Buttons */
        .action-buttons { 
            text-align: center; 
            margin: 30px 0; 
        }
        .action-button { 
            display: inline-block; 
            padding: 14px 28px; 
            margin: 8px; 
            border-radius: 8px; 
            text-decoration: none; 
            font-weight: 600; 
            font-size: 16px; 
            transition: all 0.3s ease; 
            min-width: 150px; 
        }
        .btn-warning { 
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); 
            color: white; 
            box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4); 
        }
        .btn-warning:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 6px 20px rgba(245, 158, 11, 0.6); 
        }
        .btn-success { 
            background: linear-gradient(135deg, #10b981 0%, #059669 100%); 
            color: white; 
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4); 
        }
        .btn-success:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.6); 
        }
        
        /* Footer */
        .footer { 
            background: #f9fafb; 
            padding: 30px 20px; 
            text-align: center; 
            border-top: 1px solid #e5e7eb; 
        }
        .footer-brand { 
            font-size: 18px; 
            font-weight: 600; 
            color: #374151; 
            margin-bottom: 10px; 
        }
        .footer-text { 
            font-size: 14px; 
            color: #6b7280; 
            margin: 5px 0; 
        }
        .footer-links { 
            margin-top: 15px; 
        }
        .footer-link { 
            color: #f59e0b; 
            text-decoration: none; 
            font-size: 14px; 
            margin: 0 15px; 
        }
        .footer-link:hover { color: #d97706; }
        
        /* Mobile Responsive */
        @media (max-width: 600px) {
            .email-container { margin: 10px; border-radius: 8px; }
            .header { padding: 20px 15px; }
            .header h1 { font-size: 24px; }
            .content { padding: 20px 15px; }
            .task-card { padding: 20px 15px; }
            .task-header { flex-direction: column; align-items: flex-start; }
            .task-title { margin-bottom: 10px; }
            .task-details { grid-template-columns: 1fr; gap: 15px; }
            .action-button { display: block; margin: 10px 0; width: 100%; }
            .countdown-value { font-size: 28px; }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <!-- Urgent Banner -->
        <div class="urgent-banner">
            <span class="urgent-icon">⏰</span>
            Task Deadline Approaching - Action Required
        </div>
        
        <!-- Header -->
        <div class="header">
            {{#if logoUrl}}
            <img src="{{logoUrl}}" alt="TaskFlow" class="logo">
            {{/if}}
            <h1>Deadline Reminder</h1>
            <p>Don't miss your upcoming milestone</p>
        </div>
        
        <!-- Content -->
        <div class="content">
            <!-- Greeting -->
            <div class="greeting">
                Hi {{userName}}! ⚡
            </div>
            
            <!-- Introduction -->
            <div class="intro">
                This is a friendly reminder that your task <strong>"{{taskName}}"</strong> in {{projectName}} is due soon. Please make sure to complete it on time.
            </div>
            
            <!-- Due Date Countdown -->
            <div class="due-countdown">
                <div class="countdown-label">Due Date</div>
                <div class="countdown-value">{{dueDate}}</div>
                <div class="countdown-unit">Complete before deadline</div>
            </div>
            
            <!-- Task Card -->
            <div class="task-card">
                <div class="task-header">
                    <h3 class="task-title">{{taskName}}</h3>
                    <span class="priority-badge">{{priorityLabel}} Priority</span>
                </div>
                
                {{#if taskDescription}}
                <div class="task-description">{{taskDescription}}</div>
                {{/if}}
                
                <!-- Task Details Grid -->
                <div class="task-details">
                    <div class="detail-item">
                        <div class="detail-label">📅 Due Date</div>
                        <div class="detail-value">{{dueDate}}</div>
                    </div>
                    
                    {{#if feeAmount}}
                    <div class="detail-item">
                        <div class="detail-label">💰 Fee Amount</div>
                        <div class="detail-value">KSh {{feeAmount}}</div>
                    </div>
                    {{/if}}
                    
                    <div class="detail-item">
                        <div class="detail-label">👥 Project</div>
                        <div class="detail-value">{{projectName}}</div>
                    </div>
                    
                    <div class="detail-item">
                        <div class="detail-label">📊 Status</div>
                        <div class="detail-value">In Progress</div>
                    </div>
                </div>
                
                <!-- Progress Bar -->
                <div class="progress-container">
                    <div class="progress-label">Current Progress: {{progressPercent}}%</div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: {{progressPercent}}%;"></div>
                    </div>
                </div>
            </div>
            
            <!-- Action Buttons -->
            <div class="action-buttons">
                {{#if updateUrl}}
                <a href="{{updateUrl}}" class="action-button btn-warning">Update Progress Now</a>
                {{/if}}
                {{#if taskUrl}}
                <a href="{{taskUrl}}" class="action-button btn-success">View Task Details</a>
                {{/if}}
            </div>
            
            <!-- Tips Section -->
            <div style="background: #f0f9ff; padding: 20px; border-radius: 8px; border-left: 4px solid #0ea5e9; margin-top: 20px;">
                <h4 style="color: #0c4a6e; margin-bottom: 10px;">💡 Quick Tips</h4>
                <ul style="color: #0c4a6e; margin: 0; padding-left: 20px; line-height: 1.6;">
                    <li>Update your progress regularly to keep everyone informed</li>
                    <li>If you're running behind, communicate early with your team</li>
                    <li>Use the task comments to ask questions or request help</li>
                    <li>Mark the task as complete when finished</li>
                </ul>
            </div>
        </div>
        
        <!-- Footer -->
        <div class="footer">
            <div class="footer-brand">TaskFlow</div>
            <div class="footer-text">Project Management Made Simple</div>
            <div class="footer-text">© 2024 AppKings Solutions Limited</div>
            <div class="footer-links">
                {{#if preferencesUrl}}
                <a href="{{preferencesUrl}}" class="footer-link">Manage Preferences</a>
                {{/if}}
                {{#if unsubscribeUrl}}
                <a href="{{unsubscribeUrl}}" class="footer-link">Unsubscribe</a>
                {{/if}}
            </div>
        </div>
    </div>
</body>
</html>
